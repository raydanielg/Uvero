generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =========================================================================
// ENUMS
// =========================================================================

enum UserType {
  CUSTOMER
  PROVIDER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  BANNED
  PENDING
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum ProviderAvailabilityStatus {
  ONLINE
  OFFLINE
  BUSY
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum ProviderWarningSeverity {
  LOW
  MEDIUM
  HIGH
}

enum SuspensionStatus {
  ACTIVE
  LIFTED
  EXPIRED
}

enum PricingType {
  FIXED
  DISTANCE
  QUOTE
  STARTING_PRICE
  HOURLY
}

enum RequestStatus {
  PENDING
  MATCHING
  MATCHED
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  EXPIRED
  FAILED
}

enum RequestUrgency {
  NORMAL
  URGENT
  SCHEDULED
}

enum MatchStatus {
  PENDING
  SENT
  ACCEPTED
  DECLINED
  TIMEOUT
  CANCELLED
}

enum JobStatus {
  ASSIGNED
  EN_ROUTE
  ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DISPUTED
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum PaymentMethod {
  CASH
  MOBILE_MONEY
  CARD
  WALLET
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  CANCELLED
}

enum TransactionType {
  CHARGE
  REFUND
  PAYOUT
  ADJUSTMENT
}

enum WalletTransactionType {
  CREDIT
  DEBIT
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  PROCESSING
  COMPLETED
  REJECTED
  FAILED
}

enum PayoutAccountType {
  MOBILE_MONEY
  BANK
}

enum NotificationChannel {
  PUSH
  SMS
  EMAIL
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  READ
}

enum LogStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
}

enum KycStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum KycDecision {
  APPROVED
  REJECTED
  RESUBMIT_REQUIRED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
  CLOSED
}

enum AdPlacement {
  CUSTOMER_HOME
  SERVICES_LIST
  REQUEST_SCREEN
  PROVIDER_HOME
  PROVIDER_JOBS
}

enum AdStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  PAUSED
  ENDED
}

enum AnnouncementAudience {
  ALL
  CUSTOMERS
  PROVIDERS
}

enum LegalDocumentType {
  TERMS
  PRIVACY
  PROVIDER_AGREEMENT
  REFUND_POLICY
}

enum SettingValueType {
  STRING
  NUMBER
  BOOLEAN
  JSON
}

enum IntegrationCategory {
  PAYMENT
  SMS
  EMAIL
  MAPS
  STORAGE
  PUSH
}

enum SupportPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum SupportStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_CUSTOMER
  RESOLVED
  CLOSED
}

enum ConversationType {
  DIRECT
  SUPPORT
  DISPUTE
}

// =========================================================================
// IDENTITY, ROLES & PERMISSIONS
// =========================================================================
// One `User` table backs every actor (customer, provider staff, admin
// staff). Fine-grained admin access is layered on top via Role/Permission
// so "who can do what" lives in the database, not in `if (role === ...)`
// checks scattered across the code.

model User {
  id              String     @id @default(cuid())
  phone           String     @unique
  email           String?    @unique
  passwordHash    String?
  name            String?
  userType        UserType   @default(CUSTOMER)
  status          UserStatus @default(ACTIVE)
  isPhoneVerified Boolean    @default(false)
  isEmailVerified Boolean    @default(false)
  avatarUrl       String?
  language        String     @default("sw")
  referralCode    String?    @unique
  referredById    String?
  referredBy      User?      @relation("UserReferrals", fields: [referredById], references: [id])
  referrals       User[]     @relation("UserReferrals")
  lastLoginAt     DateTime?
  deletedAt       DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  customerProfile     CustomerProfile?
  providerProfile     ProviderProfile?
  userRoles           UserRole[]
  refreshTokens       RefreshToken[]
  addresses           Address[]
  devices             UserDevice[]
  serviceRequests     ServiceRequest[]     @relation("CustomerRequests")
  conversationMembers ConversationMember[]
  sentMessages        Message[]            @relation("MessageSender")
  ratingsGiven        Rating[]             @relation("RatingFromUser")
  ratingsReceived     Rating[]             @relation("RatingToUser")
  notifications       Notification[]
  wallets             Wallet[]
  supportTickets      SupportTicket[]      @relation("SupportTicketUser")
  assignedTickets     SupportTicket[]      @relation("SupportTicketAssignee")
  disputesRaised      Dispute[]            @relation("DisputeRaisedBy")
  disputesAgainst     Dispute[]            @relation("DisputeAgainst")
  auditLogs           AuditLog[]           @relation("AuditActor")

  @@index([phone])
  @@index([userType, status])
  @@map("users")
}

model OtpCode {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  purpose    String    @default("LOGIN")
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
  @@map("otp_codes")
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model UserDevice {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pushToken    String   @unique
  platform     String
  appVersion   String?
  lastActiveAt DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([userId])
  @@map("user_devices")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique // e.g. "users.view", "settings.update"
  module      String // e.g. "users", "settings"
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId     String
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedBy String?
  createdAt  DateTime @default(now())

  @@unique([userId, roleId])
  @@map("user_roles")
}

// =========================================================================
// CUSTOMERS
// =========================================================================

model CustomerProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  maxActiveRequests Int      @default(3)
  allowGuestRequest Boolean  @default(false)
  totalRequests     Int      @default(0)
  totalSpent        Decimal  @default(0) @db.Decimal(14, 2)
  averageRating     Float?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("customer_profiles")
}

model Address {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String?
  line1     String
  line2     String?
  city      String?
  region    String?
  country   String   @default("TZ")
  lat       Float
  lng       Float
  placeId   String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  serviceRequests ServiceRequest[]

  @@index([userId])
  @@map("addresses")
}

// =========================================================================
// PROVIDERS
// =========================================================================

model ProviderProfile {
  id                 String                     @id @default(cuid())
  userId             String                     @unique
  user               User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName       String?
  bio                String?
  verificationStatus VerificationStatus         @default(UNVERIFIED)
  availabilityStatus ProviderAvailabilityStatus @default(OFFLINE)
  autoAcceptEnabled  Boolean                    @default(false)
  isApproved         Boolean                    @default(false)
  averageRating      Float                      @default(0)
  totalRatings       Int                        @default(0)
  totalJobsCompleted Int                        @default(0)
  cancellationRate   Float                      @default(0)
  responseRate       Float                      @default(0)
  maxActiveJobs      Int                        @default(3)
  autoOfflineMinutes Int                        @default(30)
  lastOnlineAt       DateTime?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  documents      ProviderDocument[]
  services       ProviderService[]
  serviceAreas   ProviderServiceArea[]
  location       ProviderLocation?
  availability   ProviderAvailabilitySchedule[]
  performance    ProviderPerformance?
  warnings       ProviderWarning[]
  suspensions    ProviderSuspension[]
  payoutAccounts PayoutAccount[]
  kycSubmissions KycSubmission[]
  jobs           Job[]
  requestMatches RequestMatch[]
  quotes         Quote[]
  withdrawals    Withdrawal[]

  @@map("provider_profiles")
}

model ProviderDocument {
  id           String          @id @default(cuid())
  providerId   String
  provider     ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  type         String // e.g. NATIONAL_ID, DRIVING_LICENSE, BUSINESS_LICENSE
  fileUrl      String
  status       DocumentStatus  @default(PENDING)
  rejectReason String?
  expiresAt    DateTime?
  reviewedBy   String?
  reviewedAt   DateTime?
  createdAt    DateTime        @default(now())

  @@index([providerId])
  @@map("provider_documents")
}

model ProviderService {
  id          String          @id @default(cuid())
  providerId  String
  provider    ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  serviceId   String
  service     Service         @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  customPrice Decimal?        @db.Decimal(12, 2)
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())

  @@unique([providerId, serviceId])
  @@map("provider_services")
}

model ProviderServiceArea {
  id         String          @id @default(cuid())
  providerId String
  provider   ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  centerLat  Float
  centerLng  Float
  radiusKm   Float           @default(5)
  region     String?
  createdAt  DateTime        @default(now())

  @@index([providerId])
  @@map("provider_service_areas")
}

model ProviderLocation {
  id         String          @id @default(cuid())
  providerId String          @unique
  provider   ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  lat        Float
  lng        Float
  heading    Float?
  speed      Float?
  updatedAt  DateTime        @updatedAt

  @@map("provider_locations")
}

model ProviderAvailabilitySchedule {
  id         String          @id @default(cuid())
  providerId String
  provider   ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  dayOfWeek  Int // 0 = Sunday ... 6 = Saturday
  startTime  String // "08:00"
  endTime    String // "18:00"
  isActive   Boolean         @default(true)

  @@index([providerId])
  @@map("provider_availability_schedules")
}

model ProviderPerformance {
  id                  String          @id @default(cuid())
  providerId          String          @unique
  provider            ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  acceptanceRate      Float           @default(0)
  onTimeRate          Float           @default(0)
  completionRate      Float           @default(0)
  averageResponseTime Int             @default(0) // seconds
  periodStart         DateTime?
  periodEnd           DateTime?
  updatedAt           DateTime        @updatedAt

  @@map("provider_performance")
}

model ProviderWarning {
  id         String                  @id @default(cuid())
  providerId String
  provider   ProviderProfile         @relation(fields: [providerId], references: [id], onDelete: Cascade)
  reason     String
  severity   ProviderWarningSeverity @default(LOW)
  issuedBy   String?
  createdAt  DateTime                @default(now())

  @@index([providerId])
  @@map("provider_warnings")
}

model ProviderSuspension {
  id         String           @id @default(cuid())
  providerId String
  provider   ProviderProfile  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  reason     String
  status     SuspensionStatus @default(ACTIVE)
  startsAt   DateTime         @default(now())
  endsAt     DateTime?
  issuedBy   String?
  liftedBy   String?
  liftedAt   DateTime?
  createdAt  DateTime         @default(now())

  @@index([providerId])
  @@map("provider_suspensions")
}

// =========================================================================
// KYC ENGINE
// =========================================================================

model KycRequirement {
  id           String   @id @default(cuid())
  name         String
  description  String?
  documentType String
  serviceId    String? // null = applies to all services
  service      Service? @relation(fields: [serviceId], references: [id])
  isRequired   Boolean  @default(true)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  documents KycDocument[]

  @@index([serviceId])
  @@map("kyc_requirements")
}

model KycSubmission {
  id          String          @id @default(cuid())
  providerId  String
  provider    ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  status      KycStatus       @default(PENDING)
  submittedAt DateTime        @default(now())
  reviewedAt  DateTime?
  reviewedBy  String?
  note        String?

  documents KycDocument[]
  reviews   KycReview[]

  @@index([providerId])
  @@map("kyc_submissions")
}

model KycDocument {
  id            String         @id @default(cuid())
  submissionId  String
  submission    KycSubmission  @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  requirementId String
  requirement   KycRequirement @relation(fields: [requirementId], references: [id])
  fileUrl       String
  status        DocumentStatus @default(PENDING)
  uploadedAt    DateTime       @default(now())

  @@index([submissionId])
  @@map("kyc_documents")
}

model KycReview {
  id           String        @id @default(cuid())
  submissionId String
  submission   KycSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reviewerId   String
  decision     KycDecision
  note         String?
  createdAt    DateTime      @default(now())

  @@index([submissionId])
  @@map("kyc_reviews")
}

// =========================================================================
// SERVICE CATALOG & PRICING ENGINE
// =========================================================================

model ServiceCategory {
  id          String            @id @default(cuid())
  name        String
  slug        String            @unique
  description String?
  iconUrl     String?
  parentId    String?
  parent      ServiceCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    ServiceCategory[] @relation("CategoryTree")
  isActive    Boolean           @default(true)
  sortOrder   Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  services Service[]

  @@map("service_categories")
}

model Service {
  id          String          @id @default(cuid())
  categoryId  String
  category    ServiceCategory @relation(fields: [categoryId], references: [id])
  name        String
  slug        String          @unique
  description String?
  iconUrl     String?
  isActive    Boolean         @default(true)
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  pricingRules     PricingRule[]
  providerServices ProviderService[]
  serviceRequests  ServiceRequest[]
  kycRequirements  KycRequirement[]

  @@index([categoryId])
  @@map("services")
}

model PricingRule {
  id           String      @id @default(cuid())
  serviceId    String
  service      Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  pricingType  PricingType
  basePrice    Decimal?    @db.Decimal(12, 2)
  pricePerKm   Decimal?    @db.Decimal(12, 2)
  pricePerHour Decimal?    @db.Decimal(12, 2)
  minimumPrice Decimal?    @db.Decimal(12, 2)
  maximumPrice Decimal?    @db.Decimal(12, 2)
  region       String? // null = default rule for the service
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([serviceId])
  @@map("pricing_rules")
}

// =========================================================================
// REQUEST ENGINE, MATCHING ENGINE & JOBS
// =========================================================================

model ServiceRequest {
  id              String         @id @default(cuid())
  customerId      String
  customer        User           @relation("CustomerRequests", fields: [customerId], references: [id])
  serviceId       String
  service         Service        @relation(fields: [serviceId], references: [id])
  addressId       String
  address         Address        @relation(fields: [addressId], references: [id])
  status          RequestStatus  @default(PENDING)
  urgency         RequestUrgency @default(NORMAL)
  description     String?
  scheduledAt     DateTime?
  estimatedPrice  Decimal?       @db.Decimal(12, 2)
  finalPrice      Decimal?       @db.Decimal(12, 2)
  cancelledReason String?
  cancelledBy     String?
  expiresAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  matches RequestMatch[]
  events  RequestEvent[]
  job     Job?
  quotes  Quote[]

  @@index([customerId])
  @@index([status])
  @@map("service_requests")
}

model RequestMatch {
  id          String          @id @default(cuid())
  requestId   String
  request     ServiceRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  providerId  String
  provider    ProviderProfile @relation(fields: [providerId], references: [id])
  status      MatchStatus     @default(PENDING)
  rank        Int             @default(0)
  distanceKm  Float?
  sentAt      DateTime?
  respondedAt DateTime?
  createdAt   DateTime        @default(now())

  @@index([requestId])
  @@index([providerId])
  @@map("request_matches")
}

model RequestEvent {
  id        String         @id @default(cuid())
  requestId String
  request   ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  eventType String
  payload   Json?
  createdAt DateTime       @default(now())

  @@index([requestId])
  @@map("request_events")
}

model Job {
  id                 String          @id @default(cuid())
  requestId          String          @unique
  request            ServiceRequest  @relation(fields: [requestId], references: [id])
  providerId         String
  provider           ProviderProfile @relation(fields: [providerId], references: [id])
  customerId         String
  status             JobStatus       @default(ASSIGNED)
  startedAt          DateTime?
  arrivedAt          DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  statusHistory JobStatusHistory[]
  payments      Payment[]
  ratings       Rating[]
  disputes      Dispute[]

  @@index([providerId])
  @@index([customerId])
  @@map("jobs")
}

model JobStatusHistory {
  id        String    @id @default(cuid())
  jobId     String
  job       Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  status    JobStatus
  note      String?
  changedBy String?
  createdAt DateTime  @default(now())

  @@index([jobId])
  @@map("job_status_history")
}

// =========================================================================
// QUOTES
// =========================================================================

model Quote {
  id         String          @id @default(cuid())
  requestId  String
  request    ServiceRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  providerId String
  provider   ProviderProfile @relation(fields: [providerId], references: [id])
  status     QuoteStatus     @default(DRAFT)
  amount     Decimal         @db.Decimal(12, 2)
  note       String?
  validUntil DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  items QuoteItem[]

  @@index([requestId])
  @@index([providerId])
  @@map("quotes")
}

model QuoteItem {
  id          String  @id @default(cuid())
  quoteId     String
  quote       Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  description String
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(12, 2)
  total       Decimal @db.Decimal(12, 2)

  @@index([quoteId])
  @@map("quote_items")
}

// =========================================================================
// PAYMENT ENGINE & WALLET ENGINE
// =========================================================================

model Payment {
  id                String             @id @default(cuid())
  jobId             String
  job               Job                @relation(fields: [jobId], references: [id])
  customerId        String
  amount            Decimal            @db.Decimal(12, 2)
  currency          String             @default("TZS")
  method            PaymentMethod
  status            PaymentStatus      @default(PENDING)
  integrationId     String?
  integration       IntegrationConfig? @relation(fields: [integrationId], references: [id])
  providerReference String?
  idempotencyKey    String?            @unique
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  transactions PaymentTransaction[]

  @@index([jobId])
  @@index([customerId])
  @@map("payments")
}

model PaymentTransaction {
  id          String          @id @default(cuid())
  paymentId   String
  payment     Payment         @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  type        TransactionType
  amount      Decimal         @db.Decimal(12, 2)
  status      PaymentStatus
  rawResponse Json?
  createdAt   DateTime        @default(now())

  @@index([paymentId])
  @@map("payment_transactions")
}

model PaymentWebhookLog {
  id              String    @id @default(cuid())
  integrationCode String
  eventType       String?
  payloadRaw      Json
  signatureValid  Boolean   @default(false)
  processed       Boolean   @default(false)
  processedAt     DateTime?
  createdAt       DateTime  @default(now())

  @@index([integrationCode])
  @@map("payment_webhook_logs")
}

model Wallet {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance   Decimal  @default(0) @db.Decimal(14, 2)
  currency  String   @default("TZS")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions WalletTransaction[]

  @@unique([userId, currency])
  @@map("wallets")
}

model WalletTransaction {
  id           String                @id @default(cuid())
  walletId     String
  wallet       Wallet                @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type         WalletTransactionType
  amount       Decimal               @db.Decimal(14, 2)
  balanceAfter Decimal               @db.Decimal(14, 2)
  reference    String?
  description  String?
  createdAt    DateTime              @default(now())

  @@index([walletId])
  @@map("wallet_transactions")
}

model PayoutAccount {
  id            String            @id @default(cuid())
  providerId    String
  provider      ProviderProfile   @relation(fields: [providerId], references: [id], onDelete: Cascade)
  type          PayoutAccountType
  accountName   String
  accountNumber String
  bankOrNetwork String // e.g. "M-Pesa", "CRDB Bank"
  isDefault     Boolean           @default(false)
  isVerified    Boolean           @default(false)
  createdAt     DateTime          @default(now())

  withdrawals Withdrawal[]

  @@index([providerId])
  @@map("payout_accounts")
}

model Withdrawal {
  id              String           @id @default(cuid())
  providerId      String
  provider        ProviderProfile  @relation(fields: [providerId], references: [id])
  payoutAccountId String
  payoutAccount   PayoutAccount    @relation(fields: [payoutAccountId], references: [id])
  amount          Decimal          @db.Decimal(14, 2)
  status          WithdrawalStatus @default(PENDING)
  requestedAt     DateTime         @default(now())
  processedAt     DateTime?
  processedBy     String?
  note            String?

  @@index([providerId])
  @@map("withdrawals")
}

// =========================================================================
// RATINGS & REVIEWS
// =========================================================================

model Rating {
  id         String   @id @default(cuid())
  jobId      String
  job        Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  fromUserId String
  fromUser   User     @relation("RatingFromUser", fields: [fromUserId], references: [id])
  toUserId   String
  toUser     User     @relation("RatingToUser", fields: [toUserId], references: [id])
  score      Int
  createdAt  DateTime @default(now())

  review Review?

  @@unique([jobId, fromUserId])
  @@index([toUserId])
  @@map("ratings")
}

model Review {
  id          String   @id @default(cuid())
  ratingId    String   @unique
  rating      Rating   @relation(fields: [ratingId], references: [id], onDelete: Cascade)
  comment     String?
  response    String?
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@map("reviews")
}

// =========================================================================
// CHAT
// =========================================================================

model Conversation {
  id        String           @id @default(cuid())
  type      ConversationType @default(DIRECT)
  jobId     String?
  createdAt DateTime         @default(now())

  members  ConversationMember[]
  messages Message[]

  @@map("conversations")
}

model ConversationMember {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime?

  @@unique([conversationId, userId])
  @@map("conversation_members")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("MessageSender", fields: [senderId], references: [id])
  body           String?
  attachmentUrl  String?
  sentAt         DateTime     @default(now())
  readAt         DateTime?

  @@index([conversationId])
  @@map("messages")
}

// =========================================================================
// NOTIFICATION ENGINE, SMS ENGINE & EMAIL ENGINE
// =========================================================================

model NotificationTemplate {
  id        String              @id @default(cuid())
  key       String              @unique // e.g. "provider_accepted"
  channel   NotificationChannel
  title     String
  body      String
  variables Json? // list of supported {variable} placeholders
  isActive  Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@map("notification_templates")
}

model Notification {
  id          String              @id @default(cuid())
  userId      String
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateKey String?
  channel     NotificationChannel
  title       String
  body        String
  data        Json?
  status      NotificationStatus  @default(PENDING)
  readAt      DateTime?
  sentAt      DateTime?
  createdAt   DateTime            @default(now())

  logs NotificationLog[]

  @@index([userId])
  @@map("notifications")
}

model NotificationLog {
  id               String       @id @default(cuid())
  notificationId   String
  notification     Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  providerResponse Json?
  status           LogStatus
  createdAt        DateTime     @default(now())

  @@index([notificationId])
  @@map("notification_logs")
}

model SmsLog {
  id              String    @id @default(cuid())
  integrationCode String
  phone           String
  message         String
  status          LogStatus @default(PENDING)
  providerMsgId   String?
  cost            Decimal?  @db.Decimal(10, 2)
  sentAt          DateTime  @default(now())

  @@index([phone])
  @@map("sms_logs")
}

model EmailTemplate {
  id        String   @id @default(cuid())
  key       String   @unique
  subject   String
  bodyHtml  String
  bodyText  String?
  variables Json?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("email_templates")
}

model EmailLog {
  id              String    @id @default(cuid())
  integrationCode String
  to              String
  subject         String
  status          LogStatus @default(PENDING)
  providerMsgId   String?
  sentAt          DateTime  @default(now())

  @@index([to])
  @@map("email_logs")
}

// =========================================================================
// DISPUTES & SUPPORT
// =========================================================================

model Dispute {
  id         String        @id @default(cuid())
  jobId      String
  job        Job           @relation(fields: [jobId], references: [id])
  raisedById String
  raisedBy   User          @relation("DisputeRaisedBy", fields: [raisedById], references: [id])
  againstId  String
  against    User          @relation("DisputeAgainst", fields: [againstId], references: [id])
  reason     String
  status     DisputeStatus @default(OPEN)
  resolution String?
  resolvedBy String?
  resolvedAt DateTime?
  createdAt  DateTime      @default(now())

  messages DisputeMessage[]

  @@index([jobId])
  @@map("disputes")
}

model DisputeMessage {
  id            String   @id @default(cuid())
  disputeId     String
  dispute       Dispute  @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  senderId      String
  body          String?
  attachmentUrl String?
  sentAt        DateTime @default(now())

  @@index([disputeId])
  @@map("dispute_messages")
}

model SupportTicket {
  id         String          @id @default(cuid())
  userId     String
  user       User            @relation("SupportTicketUser", fields: [userId], references: [id])
  subject    String
  category   String?
  priority   SupportPriority @default(MEDIUM)
  status     SupportStatus   @default(OPEN)
  assignedTo String?
  assignee   User?           @relation("SupportTicketAssignee", fields: [assignedTo], references: [id])
  createdAt  DateTime        @default(now())
  resolvedAt DateTime?

  messages SupportMessage[]

  @@index([userId])
  @@index([status])
  @@map("support_tickets")
}

model SupportMessage {
  id            String        @id @default(cuid())
  ticketId      String
  ticket        SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId      String
  body          String?
  attachmentUrl String?
  sentAt        DateTime      @default(now())

  @@index([ticketId])
  @@map("support_messages")
}

// =========================================================================
// ADS ENGINE
// =========================================================================

model AdCampaign {
  id        String    @id @default(cuid())
  name      String
  budget    Decimal?  @db.Decimal(12, 2)
  startDate DateTime?
  endDate   DateTime?
  status    AdStatus  @default(DRAFT)
  createdAt DateTime  @default(now())

  ads Ad[]

  @@map("ad_campaigns")
}

model Ad {
  id             String      @id @default(cuid())
  campaignId     String?
  campaign       AdCampaign? @relation(fields: [campaignId], references: [id])
  title          String
  description    String?
  imageUrl       String
  linkUrl        String?
  placement      AdPlacement
  priority       Int         @default(0)
  status         AdStatus    @default(DRAFT)
  startDate      DateTime?
  endDate        DateTime?
  targetAudience Json?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  impressions AdImpression[]
  clicks      AdClick[]

  @@index([placement, status])
  @@map("ads")
}

model AdImpression {
  id       String   @id @default(cuid())
  adId     String
  ad       Ad       @relation(fields: [adId], references: [id], onDelete: Cascade)
  userId   String?
  viewedAt DateTime @default(now())

  @@index([adId])
  @@map("ad_impressions")
}

model AdClick {
  id        String   @id @default(cuid())
  adId      String
  ad        Ad       @relation(fields: [adId], references: [id], onDelete: Cascade)
  userId    String?
  clickedAt DateTime @default(now())

  @@index([adId])
  @@map("ad_clicks")
}

// =========================================================================
// CONTENT MANAGEMENT
// =========================================================================

model ContentPage {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  bodyHtml    String
  isPublished Boolean  @default(true)
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("content_pages")
}

model Faq {
  id          String   @id @default(cuid())
  category    String?
  question    String
  answer      String
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@map("faqs")
}

model Banner {
  id        String    @id @default(cuid())
  title     String
  imageUrl  String
  linkUrl   String?
  placement String
  startDate DateTime?
  endDate   DateTime?
  isActive  Boolean   @default(true)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())

  @@map("banners")
}

model Announcement {
  id        String               @id @default(cuid())
  title     String
  body      String
  audience  AnnouncementAudience @default(ALL)
  startDate DateTime?
  endDate   DateTime?
  isActive  Boolean              @default(true)
  createdAt DateTime             @default(now())

  @@map("announcements")
}

model LegalDocument {
  id          String            @id @default(cuid())
  type        LegalDocumentType
  version     String
  bodyHtml    String
  effectiveAt DateTime          @default(now())
  createdAt   DateTime          @default(now())

  @@unique([type, version])
  @@map("legal_documents")
}

// =========================================================================
// CONFIGURATION ENGINE (settings, branding, feature flags)
// =========================================================================

model Setting {
  id          String           @id @default(cuid())
  key         String           @unique // e.g. "matching.search_radius"
  value       String // JSON-encoded when valueType = JSON
  valueType   SettingValueType @default(STRING)
  category    String // e.g. "matching", "pricing", "provider"
  description String?
  isPublic    Boolean          @default(false)
  isEditable  Boolean          @default(true)
  updatedBy   String?
  updatedAt   DateTime         @updatedAt
  createdAt   DateTime         @default(now())

  @@index([category])
  @@map("settings")
}

model Branding {
  id              String   @id @default(cuid())
  appName         String   @default("Uvero")
  logoUrl         String?
  darkLogoUrl     String?
  faviconUrl      String?
  primaryColor    String   @default("#0F62FE")
  secondaryColor  String?
  accentColor     String?
  backgroundColor String?
  textColor       String?
  fontFamily      String?
  supportEmail    String?
  supportPhone    String?
  website         String?
  termsUrl        String?
  privacyUrl      String?
  updatedBy       String?
  updatedAt       DateTime @updatedAt

  @@map("branding")
}

model FeatureFlag {
  id                String   @id @default(cuid())
  key               String   @unique // e.g. "wallet", "scheduled_requests"
  name              String
  description       String?
  isEnabled         Boolean  @default(false)
  rolloutPercentage Int      @default(100)
  updatedBy         String?
  updatedAt         DateTime @updatedAt
  createdAt         DateTime @default(now())

  @@map("feature_flags")
}

// =========================================================================
// INTEGRATION ENGINE (payments, sms, email, maps, storage, push)
// =========================================================================

model IntegrationConfig {
  id                   String              @id @default(cuid())
  category             IntegrationCategory
  code                 String              @unique // e.g. "selcom", "azampay", "twilio"
  name                 String
  isEnabled            Boolean             @default(false)
  isDefault            Boolean             @default(false)
  credentialsEncrypted String? // encrypted blob, decrypted only in the provider adapter
  config               Json? // non-secret config (sender IDs, templates, endpoints)
  updatedBy            String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  payments Payment[]

  @@index([category])
  @@map("integration_configs")
}

model WebhookSubscription {
  id        String   @id @default(cuid())
  url       String
  secret    String
  events    String[] // e.g. ["job.completed", "payment.completed"]
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  deliveries WebhookDelivery[]

  @@map("webhook_subscriptions")
}

model WebhookDelivery {
  id             String              @id @default(cuid())
  subscriptionId String
  subscription   WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  event          String
  payload        Json
  responseStatus Int?
  attempt        Int                 @default(1)
  deliveredAt    DateTime?
  createdAt      DateTime            @default(now())

  @@index([subscriptionId])
  @@map("webhook_deliveries")
}

// =========================================================================
// AUDIT & ANALYTICS
// =========================================================================

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id])
  action     String // e.g. "UPDATED_PLATFORM_COMMISSION"
  entityType String?
  entityId   String?
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model AnalyticsEvent {
  id         String   @id @default(cuid())
  name       String // e.g. "REQUEST_CREATED", "JOB_COMPLETED"
  userId     String?
  sessionId  String?
  source     String? // "customer_app", "provider_app", "admin", "api"
  properties Json?
  occurredAt DateTime @default(now())

  @@index([name, occurredAt])
  @@index([userId])
  @@map("analytics_events")
}
